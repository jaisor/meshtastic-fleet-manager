{
  "name": "meshtastic-fleet-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -b --force tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "start": "node dist/server/index.js",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@meshtastic/core": "2.6.7",
    "@meshtastic/protobufs": "^2.8.0",
    "@meshtastic/transport-node-serial": "^0.0.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "ste-simple-events": "^3.0.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true,
    "@meshtastic/core@2.6.7": false,
    "@meshtastic/transport-node-serial@0.0.2": false
  }
}
